# Dedicated Helius API key for MonkeLedger — MUST be separate from any key used by
# other production services you run. This service is meant to be public-facing and
# forkable; if its own key ever gets rate-limited or exhausted by heavy traffic, that
# must never bleed into anything else's quota. Get a free key at helius.dev.
HELIUS_API_KEY=

# The Merkle tree address to index (a compressed-NFT collection lives in one tree).
TREE_ADDRESS=2uH9TkmYkAKGrK7EPnd4Y7JVYswpQ2aED9deMn8QoYVy

# The collection address to snapshot via DAS getAssetsByGroup (distinct from the tree
# address — a tree holds leaves, a collection is a metadata grouping).
COLLECTION_ADDRESS=GokAiStXz2Kqbxwz2oqzfEXuUhE7aXySmBGEP7uejKXF

# HTTP server
PORT=3002
BIND_HOST=0.0.0.0

# Cheap on-chain-root polling (ms) — no DAS call, just a plain getAccountInfo, so this can be
# frequent. A full collection snapshot only runs when this actually detects the root changed.
POLL_INTERVAL_MS=120000

# RPC endpoint for the cheap poll above. Defaults to the free public RPC since polling doesn't
# need DAS/Helius at all — override only if that endpoint's rate limits become a problem for you.
POLL_RPC_URL=https://api.mainnet-beta.solana.com

# Full-collection re-sync (ms) as a SAFETY NET only — the poll loop above is what actually catches
# real changes (any leaf mutation changes that leaf's hash and therefore the root, so polling
# catches transfers, metadata updates, and burns alike, not just sales). Fine to leave long.
REFRESH_INTERVAL_MS=86400000

# Per-IP rate limit for the public HTTP endpoints (requests per window).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Optional. Only set this if you're running the Cloudflare Worker in worker/ in front of this
# service — it lets the backend trust the real client IP the Worker forwards (otherwise every
# request would appear to come from Cloudflare's edge and rate limiting would break). Must match
# the PROXY_SECRET set via `wrangler secret put` in worker/. Leave blank to run standalone.
PROXY_SECRET=
