# Dedicated Helius API key for MonkeLedger — MUST be separate from any key used by
# other production services you run. This service is meant to be public-facing and
# forkable; if its own key ever gets rate-limited or exhausted by heavy traffic, that
# must never bleed into anything else's quota. Get a free key at helius.dev.
HELIUS_API_KEY=

# The Merkle tree address to index (a compressed-NFT collection lives in one tree).
TREE_ADDRESS=2uH9TkmYkAKGrK7EPnd4Y7JVYswpQ2aED9deMn8QoYVy

# The collection address to snapshot via DAS getAssetsByGroup (distinct from the tree
# address — a tree holds leaves, a collection is a metadata grouping).
COLLECTION_ADDRESS=GokAiStXz2Kqbxwz2oqzfEXuUhE7aXySmBGEP7uejKXF

# HTTP server
PORT=3002
BIND_HOST=0.0.0.0

# How often to re-sync against the chain (ms). Don't go below a couple minutes —
# a full collection snapshot is a real cost against your Helius quota every cycle.
REFRESH_INTERVAL_MS=600000

# Per-IP rate limit for the public HTTP endpoints (requests per window).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
